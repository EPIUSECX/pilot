{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pilot Desktop",
  "version": "0.1.0",
  "identifier": "com.epiuse.pilot-desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pilot Desktop",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../bridge/pilot_desktop_bridge.py": "bridge/pilot_desktop_bridge.py",
      "../bridge/PILOT_REVISION": "bridge/PILOT_REVISION"
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
