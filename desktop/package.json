{
  "name": "pilot-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "postinstall": "node scripts/check-dependencies.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src scripts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --bundles app,dmg",
    "preview": "PILOT_DESKTOP_PREVIEW=1 vite"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "frappe-ui": "1.1.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  }
}
